{
  "name": "dm-screen",
  "version": "1.1.1",
  "description": "DM Screen - Obsidian plugin for D&D campaign management with player screen",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && cp main.js manifest.json styles.css ../../obsidian/calradia/.obsidian/plugins/dm-screen/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "dnd",
    "dm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@playwright/test": "1.60.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^4.1.8",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.8.9",
    "mocha": "^11.7.6",
    "obsidian": "latest",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1",
    "webdriverio": "^9.30.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ws": "^8.20.1"
  }
}
