{
  "name": "dm-screen",
  "version": "0.6.0-beta.8",
  "description": "DM Screen - Obsidian plugin for D&D campaign management with interactive maps and player screen",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && cp main.js manifest.json styles.css ../../obsidian/calradia/.obsidian/plugins/dm-screen/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "dnd",
    "dm",
    "maps"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^15.10.0",
    "obsidian": "latest",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "ws": "^8.18.0"
  }
}
