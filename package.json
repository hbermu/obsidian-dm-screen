{
  "name": "dm-screen",
  "version": "0.8.1-beta.3",
  "description": "DM Screen - Obsidian plugin for D&D campaign management with player screen",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && cp main.js manifest.json styles.css ../../obsidian/calradia/.obsidian/plugins/dm-screen/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "dnd",
    "dm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^3.2.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.8.9",
    "obsidian": "latest",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "ws": "^8.20.1"
  }
}
